<?xml version="1.0"?>
<sdf version="1.9">
  <world name="umn_campus">
    <physics name="default" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 500 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <!-- campus map: run with GZ_SIM_RESOURCE_PATH pointing at the folder ABOVE umn_campus/ -->
    <include>
      <uri>model://umn_campus</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- simple "wearer": a person-sized capsule with a chest-height 3D LiDAR.
         Spawned on a footpath near Washington Ave / East Bank (ground z ~ 8.7 m). -->
    <model name="wearer">
      <pose>-100.34 340.0 10.0 0 0 0</pose>
      <link name="body">
        <inertial>
          <mass>70</mass>
          <inertia><ixx>12</ixx><iyy>12</iyy><izz>1</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="col">
          <geometry><capsule><radius>0.25</radius><length>1.2</length></capsule></geometry>
        </collision>
        <visual name="vis">
          <geometry><capsule><radius>0.25</radius><length>1.2</length></capsule></geometry>
          <material><diffuse>0.1 0.4 0.9 1</diffuse></material>
        </visual>

        <sensor name="chest_lidar" type="gpu_lidar">
          <pose>0.2 0 0.35 0 0 0</pose>
          <topic>/wearer/lidar</topic>
          <update_rate>10</update_rate>
          <visualize>true</visualize>
          <lidar>
            <scan>
              <horizontal><samples>720</samples><resolution>1</resolution>
                <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal>
              <vertical><samples>16</samples><resolution>1</resolution>
                <min_angle>-0.2618</min_angle><max_angle>0.2618</max_angle></vertical>
            </scan>
            <range><min>0.2</min><max>30.0</max><resolution>0.01</resolution></range>
            <noise><type>gaussian</type><mean>0</mean><stddev>0.02</stddev></noise>
          </lidar>
        </sensor>

        <sensor name="imu" type="imu">
          <topic>/wearer/imu</topic>
          <update_rate>100</update_rate>
        </sensor>
      </link>

      <!-- drive the wearer with geometry_msgs/Twist on /wearer/cmd_vel -->
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/wearer/cmd_vel</topic>
      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_topic>/wearer/odom</odom_topic>
        <odom_frame>map</odom_frame>
        <robot_base_frame>wearer</robot_base_frame>
        <dimensions>2</dimensions>
      </plugin>
    </model>
  </world>
</sdf>
